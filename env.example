# Upstash Redis Configuration
# Get these values from your Upstash Redis dashboard (https://console.upstash.com/)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token

API_KEY=custom-key

# Optional: Anthropic OAuth Client ID 
# Defaults to the official Claude CLI ID if not provided
# ANTHROPIC_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e

# Optional: Server port 
# Defaults to 9095 if not provided
PORT=8080

# Optional: Public tunnel URL (without protocol)
TUNNEL_URL=8080.buremba.com

# Optional: OpenAI OAuth scopes (device flow)
# Defaults to model.request if not provided
# OPENAI_OAUTH_SCOPE=model.request

# Optional: ChatGPT backend base URL
# Defaults to https://chatgpt.com/backend-api/codex
# CHATGPT_BASE_URL=https://chatgpt.com/backend-api/codex

# Optional: Non-Claude backend selection for /v1/chat/completions
# - auto (default): OpenAI key → OpenAI API, JWT/account_id → ChatGPT backend
# - codex-cli: use local `codex exec` (requires `codex login` first)
# OPENAI_BACKEND=codex-cli

# Optional: Codex CLI backend settings (only used when OPENAI_BACKEND=codex-cli or API key is "codex-cli")
# Default: process.cwd()
# CODEX_CLI_WORKDIR=/path/to/your/project
# Default: read-only
# CODEX_CLI_SANDBOX=read-only
# Default: 300000 (5 minutes)
# CODEX_CLI_TIMEOUT_MS=300000
# Optional: force model (leave empty to use Codex CLI default)
# CODEX_CLI_MODEL=gpt-5.2-codex
